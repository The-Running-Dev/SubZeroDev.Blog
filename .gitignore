# Secrets and local configuration
.env
.env.*
!.env.example
# Committed on purpose: a non-secret Compose validation fixture whose every
# value is an invalid placeholder. See tools/blog-mcp/.env.ci's own header.
!.env.ci
*.pem
*.key

# Dependencies and caches
node_modules/
.docusaurus/
.cache/
coverage/

# Build output
artifacts/
build-output/
dist/
# tools/git-service-consumer's compiled registry artifact -- regenerable via
# tools/git-service-consumer/scripts/build-registry.ts, same convention as
# SubZeroDev.GitService's own gitignored build/.
tools/git-service-consumer/build/

# Per-machine Claude Code settings; the tracked settings.json is deliberate
.claude/settings.local.json

# Per-machine session costs, written by the SessionEnd hook. Regenerable from
# the transcripts at any time, and meaningless on another machine.
.claude/session-costs.tsv

# Editors and operating systems
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db
Desktop.ini

# Logs and temporary files
*.log
*.tmp
*.temp
