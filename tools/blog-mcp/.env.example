# Copy this file to .env (already git-ignored) and fill in real values.
# Never commit the real .env -- see tools/blog-mcp/README.md for the full
# explanation of each of these.

# --- Repo acquisition (required) --------------------------------------------
# The repo this container clones/reconciles on every start. No bind mount --
# see README.md's "Why a container with no Docker inside it" / "Repo
# acquisition" sections.
BLOG_MCP_CLONE_URL=https://github.com/The-Running-Dev/SubZeroDev.Blog.git

# Git identity for commits made inside the container. Set repo-local (in the
# workspace volume), not --global -- nothing else sets this, so a fresh clone
# would otherwise fail every commit with "Please tell me who you are".
BLOG_MCP_GIT_USER_NAME=blog-bot
BLOG_MCP_GIT_USER_EMAIL=bot@subzerodev.com

# Repo path inside the container volume. Leave unset unless you have a
# specific reason to change it -- defaults to /workspace, matching the named
# volume docker-compose.yml already mounts there.
# BLOG_MCP_WORKSPACE=/workspace

# --- HTTP / serve mode --------------------------------------------------------
# BLOG_MCP_HTTP_HOST is fixed to 0.0.0.0 in docker-compose.yml itself (not
# here) -- required for the published port to reach the container at all.
BLOG_MCP_HTTP_PORT=8765

# Bearer token required on every /mcp request. Strongly recommended once this
# is reachable from anywhere but localhost; without it the server logs a
# warning and runs unauthenticated.
BLOG_MCP_HTTP_TOKEN=

# Comma-separated Origin allowlist for browser-based clients. Defaults to this
# server's own http://<host>:<port> if unset.
# BLOG_MCP_HTTP_ALLOWED_ORIGINS=

# scrypt hash (see src/serve/auth.ts's hashPassword) required for the web UI's
# /login and /api. Unset disables the UI entirely (404) -- /mcp and /healthz
# keep working either way. Generate one after `npm run build`:
#   node -e "console.log(require('./dist/serve/auth.js').hashPassword(process.argv[1]))" '<password>'
# Deliberately a separate secret from BLOG_MCP_HTTP_TOKEN -- one is a machine
# bearer token, the other a password a human types into a browser.
BLOG_MCP_UI_PASSWORD_HASH=

# Public HTTPS origin used as the OAuth issuer for remote MCP clients such as
# Claude. OAuth is enabled only when this and BLOG_MCP_UI_PASSWORD_HASH are
# both set. Do not use a Docker service name or an internal address here.
# BLOG_MCP_OAUTH_ISSUER=https://blogging.subzerodev.com

# --- Capability tiers (all opt-in, off by default) ----------------------------
# Unregisters every write tool (local authoring + git + remote). Tier D
# (monitoring) stays registered, since it's read-only.
# BLOG_MCP_READ_ONLY=1

# Registers push/PR-creation/auto-merge. Required (along with a real GH_TOKEN
# below) for any of the write workflow past local commits, and required
# (together with BLOG_MCP_ALLOW_SCHEDULER) for the cron scheduler.
# BLOG_MCP_ALLOW_REMOTE=1

# CI/deploy monitoring is on by default (it's read-only). Set to 0 to
# disable it explicitly.
# BLOG_MCP_ALLOW_MONITOR=0

# Registers blog_schedule_publish/_list_scheduled_jobs/_cancel_scheduled_job
# and starts the 60s tick loop. Requires BLOG_MCP_ALLOW_REMOTE=1 too.
# BLOG_MCP_ALLOW_SCHEDULER=1

# Starts the directory watcher (see the "--- Watcher (directory) ---" section
# below for its own settings). Requires BLOG_MCP_ALLOW_REMOTE=1 too --
# publishing a dropped file needs push/PR/auto-merge, not just a local write.
# BLOG_MCP_ALLOW_WATCHER=1

# --- Watcher (directory) -------------------------------------------------------
# Polls a directory for new *.md files and publishes each one automatically:
# branch -> create/update post -> stage -> commit -> push -> open PR -> enable
# auto-merge. A dropped file must already have complete front matter (title,
# description, slug, at least one tag) -- unlike the web UI's "Paste raw
# markdown" feature, there's no human here to catch a bad guess, so an
# incomplete file is rejected and moved to <dir>/failed/ with a .error.txt
# explaining why, never silently patched up. See README.md's "Watcher
# (directory)" section for the full directory layout and failure handling.
#
# Container-side path the watcher polls. Also used as the bind mount's target
# in docker-compose.yml -- must match BLOG_MCP_WATCH_HOST_DIR's mount point.
# BLOG_MCP_WATCH_DIR=/watch

# Host directory bind-mounted to BLOG_MCP_WATCH_DIR above (docker-compose.yml
# only -- not read by the server itself). Needs to be writable by uid 1000
# (the container's non-root `node` user): `chown 1000:1000 ./watch` on Linux
# hosts, since a bind mount arrives with the host's ownership, unlike the
# auto-chowned blog-workspace named volume.
# BLOG_MCP_WATCH_HOST_DIR=./watch

# Poll interval in milliseconds.
# BLOG_MCP_WATCH_INTERVAL_MS=15000

# On by default -- a PR the watcher opens also has auto-merge enabled
# once its required checks pass, same as the web UI's Compose form default.
# Set to 0 to leave every watcher-opened PR for manual review instead.
# BLOG_MCP_WATCH_AUTO_MERGE=0

# --- GitHub CLI auth (required for any remote/monitor/scheduler tool) ---------
# A fine-grained PAT scoped to this one repo (contents: write, pull_requests:
# write). No `actions: write` unless you also intend to use a future
# blog_dispatch_deploy tool. Never write the real token into this .env.example
# file -- only into your own git-ignored .env.
GH_TOKEN=
