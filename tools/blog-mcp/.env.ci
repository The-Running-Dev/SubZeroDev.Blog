# CI-only Compose validation fixture. NOT a configuration: every value here is
# a deliberately invalid placeholder that exists solely so
# `docker compose config` can expand this repository's two Compose files
# without erroring on a mandatory ${VAR:?...} variable. Never use these values
# for a real deployment. Never put a real credential in this file -- it is
# committed on purpose, via .gitignore's `!.env.ci` exception.
#
# Only the four :?-mandatory variables in the repository root's
# docker-compose.yml need a value here. Every other variable in that file and
# in tools/blog-mcp/docker-compose.yml already carries a :- default, so
# `config` resolves them without help.
#
# .github/workflows/blog-mcp-image.yml's `compose` job also copies this file
# to tools/blog-mcp/.env, because that Compose file declares
# `env_file: - .env` and a missing env_file is a hard error for `config`.
# See tools/blog-mcp/.env.example for the real, documented variable set.

BLOG_MCP_CLONE_URL=https://invalid.example/ci-fixture/not-a-real-repository.git
BLOG_MCP_GIT_USER_NAME=ci-fixture-not-a-real-identity
BLOG_MCP_GIT_USER_EMAIL=ci-fixture@invalid.example
BLOG_MCP_HTTP_TOKEN=ci-fixture-not-a-real-token-do-not-use
